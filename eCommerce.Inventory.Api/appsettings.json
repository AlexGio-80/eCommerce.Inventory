{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "ThisIsASecretKeyForJwtTokenGenerationAndValidation_MustBeLongEnough",
    "Issuer": "eCommerce.Inventory",
    "Audience": "eCommerce.Inventory.User"
  },
  "Api": {
    "BaseUrl": "http://localhost:5152",
    "Port": 5152
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=TaffelInventory;Trusted_Connection=True;Encrypt=False;TrustServerCertificate=True;"
  },
  "CardTraderApi": {
    "BaseUrl": "https://api.cardtrader.com/api/v2",
    "BearerToken": "YOUR_CARDTRADER_API_TOKEN_HERE",
    "SharedSecret": "YOUR_CARDTRADER_SHARED_SECRET_HERE",
    "UserId": 1939
  },
  "SyncSettings": {
    "ProductSyncTime": "01:00",
    "RunAnalyticsDuringSync": false,
    "PopulateItalianNamesOnStartup": false,
    "PopulateSealedPricesOnStartup": false
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "Enrich": [
      "FromLogContext",
      "WithThreadId",
      "WithProcessId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ecommerce-inventory-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Backup": {
    "Enabled": true,
    "Schedule": "0 2 * * *",
    "RetentionDays": 3,
    "BackupPath": "Backups",
    "BackupDestinationPath": null
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "Enabled": false,
    "InstanceName": "ecommerce-inventory"
  },
  "CacheSettings": {
    "GamesTtlHours": 24,
    "ExpansionsTtlHours": 12,
    "BlueprintsTtlHours": 6
  }
}
